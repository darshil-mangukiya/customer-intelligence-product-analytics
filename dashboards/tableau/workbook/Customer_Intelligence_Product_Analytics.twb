        <style>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='true' />
            <format attr='display-field-labels' scope='cols' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.p3_customer_analytics].[none:segment_name:nk]' />
              <size column='[federated.p3_customer_analytics].[sum:expected_clv_at_risk:qk]' />
              <lod column='[federated.p3_customer_analytics].[none:segment_name:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontname='Tableau Semibold' fontsize='10'>Segment Risk Value&#10;</run>
                <run fontsize='9'>Modeled risk and value; review priority, not causal evidence.
Synthetic/generated portfolio evidence; no realized commercial impact.</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.p3_customer_analytics].[avg:predicted_12m_clv:qk]</rows>
        <cols>[federated.p3_customer_analytics].[avg:churn_probability:qk]</cols>
