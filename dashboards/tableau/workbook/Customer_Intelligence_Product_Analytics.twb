            <zone fixed-size='125' h='16276' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='100000' x='0' y='3776' />
            <zone h='79948' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='100000' x='0' y='20052'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Business context — customer health, value, and risk' captured-sheet='Executive Overview' id='1' />
                  <story-point caption='Which customers matter most?' captured-sheet='Customer Segmentation' id='2' />
                  <story-point caption='Which customers are most at modeled risk?' captured-sheet='Churn &amp; Retention' id='3' />
