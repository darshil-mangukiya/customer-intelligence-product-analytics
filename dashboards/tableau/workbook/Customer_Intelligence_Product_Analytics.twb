      <aliases enabled='yes' />
      <column datatype='real' name='[All-customer Revenue (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([net_revenue]) }' />
      </column>
      <column datatype='string' name='[CLV Band (Display)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([clv_band], &quot;Unknown&quot;)' />
      </column>
      <column datatype='integer' name='[Customer Count]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column datatype='real' name='[Customer Lifetime Profit (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : MAX([return_adjusted_profit]) }' />
      </column>
      <column datatype='real' name='[Customer Lifetime Revenue (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : MAX([net_revenue]) }' />
      </column>
      <column datatype='real' name='[Metric Selector Value]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric Selector] WHEN &quot;Revenue&quot; THEN SUM([net_revenue]) WHEN &quot;Profit&quot; THEN SUM([return_adjusted_profit]) WHEN &quot;CLV&quot; THEN AVG([predicted_12m_clv]) WHEN &quot;Churn Risk&quot; THEN AVG([churn_probability]) WHEN &quot;Customer Count&quot; THEN COUNTD([customer_id]) END' />
      </column>
      <column datatype='string' name='[Modeled High Risk]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churn_probability] &gt;= [Parameters].[Risk Threshold] THEN &quot;Above threshold&quot; ELSE &quot;Below threshold&quot; END' />
      </column>
      <column datatype='real' name='[Observed Churn Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(FLOAT([churn_label]))' />
      </column>
      <column datatype='real' name='[Observed Retention Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Observed Churn Rate]' />
      </column>
      <column datatype='real' name='[Profit per Customer]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([return_adjusted_profit]) / COUNTD([customer_id])' />
      </column>
      <column datatype='real' name='[Revenue per Customer]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_revenue]) / COUNTD([customer_id])' />
      </column>
      <column datatype='real' name='[Risk × Value Score]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[churn_probability] * [predicted_12m_clv]' />
      </column>
      <column datatype='integer' name='[Segment Customer Count (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [segment_name] : COUNTD([customer_id]) }' />
      </column>
      <column datatype='real' name='[Segment Percent of Total]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_revenue]) / TOTAL(SUM([net_revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Segment Revenue (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [segment_name] : SUM([net_revenue]) }' />
      </column>
      <column datatype='real' name='[Segment Revenue Share (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Segment Revenue (LOD)] / [All-customer Revenue (LOD)]' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <drill-paths>
        <drill-path name='Customer'>
          <field>[segment_name]</field>
          <field>[clv_band]</field>
          <field>[churn_risk_tier]</field>
        </drill-path>
      </drill-paths>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Metric Selector' datatype='string' name='[Metric Selector]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue&quot;'>
          <calculation class='tableau' formula='&quot;Revenue&quot;' />
        </column>
        <column caption='Risk Threshold' datatype='real' name='[Risk Threshold]' param-domain-type='range' role='measure' type='quantitative' value='0.7'>
          <calculation class='tableau' formula='0.7' />
          <range granularity='0.05' max='1.0' min='0.0' />
        </column>
      </datasource-dependencies>
