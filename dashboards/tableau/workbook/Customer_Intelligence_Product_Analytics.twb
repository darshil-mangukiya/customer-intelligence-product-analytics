      <activation auto-clear='true' type='on-select' />
      <source dashboard='Executive Overview' type='sheet' worksheet='Executive Segment Distribution' />
      <link caption='Executive Segment → Customer Segmentation Filter' delimiter=',' escape='\' expression='tsl:Customer Segmentation?segment_name=&amp;lt;[segment_name]~na&amp;gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Executive Segment Distribution' />
        <param name='target' value='Customer Segmentation' />
      </command>
    </action>
    <action caption='Executive Segment → Churn &amp; Retention Filter' name='[Action2_ExecutiveSegmentChurnRet]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Executive Overview' type='sheet' worksheet='Executive Segment Distribution' />
      <link caption='Executive Segment → Churn &amp; Retention Filter' delimiter=',' escape='\' expression='tsl:Churn &amp; Retention?segment_name=&amp;lt;[segment_name]~na&amp;gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Executive Segment Distribution' />
        <param name='target' value='Churn &amp; Retention' />
      </command>
    </action>
    <action caption='Segment Highlight' name='[Action3_SegmentHighlight]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Customer Segmentation' type='sheet' worksheet='Segment Comparison' />
      <command command='tsc:brush'>
        <param name='field-captions' value='segment_name' />
        <param name='target' value='Customer Segmentation' />
      </command>
    </action>
    <action caption='Cohort Heatmap → Retention Curves' name='[Action4_CohortHeatmapRetentionCu]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Cohort Retention' type='sheet' worksheet='Cohort Heatmap' />
      <link caption='Cohort Heatmap → Retention Curves' delimiter=',' escape='\' expression='tsl:Cohort Retention?cohort_month=&amp;lt;[cohort_month]~na&amp;gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Cohort Heatmap' />
        <param name='target' value='Cohort Retention' />
      </command>
    </action>
    <action caption='Category → Product Detail' name='[Action5_CategoryProductDetail]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Product Profitability' type='sheet' worksheet='Category Profitability' />
      <link caption='Category → Product Detail' delimiter=',' escape='\' expression='tsl:Product Profitability?category=&amp;lt;[category]~na&amp;gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Category Profitability' />
        <param name='target' value='Product Profitability' />
      </command>
    </action>
  </actions>
