      <aliases enabled='yes' />
      <column datatype='string' name='[Confidence Interval Label]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(MAX([confidence_interval_low]) * 100, 2)) + &quot;% to &quot; + STR(ROUND(MAX([confidence_interval_high]) * 100, 2)) + &quot;%&quot;' />
      </column>
      <column datatype='real' name='[Conversion Rate Difference]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(AVG([conversion_rate]), 0) - LOOKUP(AVG([conversion_rate]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Experiment Absolute Lift]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([absolute_difference]) * 100' />
      </column>
      <column datatype='real' name='[Experiment Relative Lift]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([relative_lift])' />
      </column>
      <column datatype='string' name='[Experiment View Label]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Experiment View] WHEN &quot;Absolute Lift&quot; THEN STR(ROUND(MAX([absolute_difference]) * 100, 2)) + &quot; pp&quot; WHEN &quot;Relative Lift&quot; THEN STR(ROUND(MAX([relative_lift]) * 100, 1)) + &quot;%&quot; WHEN &quot;Statistical Significance&quot; THEN [Statistical Status] ELSE [Practical Status] END' />
      </column>
      <column datatype='string' name='[Practical Status]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS(MAX([absolute_difference])) &gt;= MAX([practical_threshold]) THEN &quot;Practically significant&quot; ELSE &quot;Below practical threshold&quot; END' />
      </column>
      <column datatype='string' name='[Statistical Status]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([p_value]) &lt; MAX([alpha]) THEN &quot;Statistically significant&quot; ELSE &quot;Not statistically significant&quot; END' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Experiment View' datatype='string' name='[Experiment View]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Lift&quot;'>
          <calculation class='tableau' formula='&quot;Absolute Lift&quot;' />
        </column>
      </datasource-dependencies>
