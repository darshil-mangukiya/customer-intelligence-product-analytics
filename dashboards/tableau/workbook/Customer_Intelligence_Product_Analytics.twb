      <aliases enabled='yes' />
      <column datatype='real' name='[Category Revenue (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [category] : SUM([net_revenue]) }' />
      </column>
      <column datatype='real' name='[Cumulative Profit]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([return_adjusted_profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[Product Rank]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([return_adjusted_profit]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Product Return Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returns]) / SUM([orders])' />
      </column>
      <column datatype='real' name='[Profit Margin]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([return_adjusted_profit]) / SUM([net_revenue])' />
      </column>
      <column datatype='boolean' name='[Top N Filter]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Product Rank] &lt;= [Parameters].[Top N]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <drill-paths>
        <drill-path name='Product'>
          <field>[category]</field>
          <field>[sub_category]</field>
          <field>[product_name]</field>
        </drill-path>
      </drill-paths>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Top N' datatype='integer' name='[Top N]' param-domain-type='list' role='measure' type='quantitative' value='10'>
          <calculation class='tableau' formula='10' />
        </column>
      </datasource-dependencies>
