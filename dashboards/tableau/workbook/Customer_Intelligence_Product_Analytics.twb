  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Experiment View' datatype='string' name='[Experiment View]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Lift&quot;'>
        <calculation class='tableau' formula='&quot;Absolute Lift&quot;' />
        <members>
          <member value='&quot;Absolute Lift&quot;' />
          <member value='&quot;Relative Lift&quot;' />
          <member value='&quot;Statistical Significance&quot;' />
          <member value='&quot;Practical Significance&quot;' />
        </members>
      </column>
      <column caption='Metric Selector' datatype='string' name='[Metric Selector]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue&quot;'>
        <calculation class='tableau' formula='&quot;Revenue&quot;' />
        <members>
          <member value='&quot;Revenue&quot;' />
          <member value='&quot;Profit&quot;' />
          <member value='&quot;CLV&quot;' />
          <member value='&quot;Churn Risk&quot;' />
          <member value='&quot;Customer Count&quot;' />
        </members>
      </column>
      <column caption='Risk Threshold' datatype='real' name='[Risk Threshold]' param-domain-type='range' role='measure' type='quantitative' value='0.7'>
        <calculation class='tableau' formula='0.7' />
        <range granularity='0.05' max='1.0' min='0.0' />
      </column>
      <column caption='Top N' datatype='integer' name='[Top N]' param-domain-type='list' role='measure' type='quantitative' value='10'>
        <calculation class='tableau' formula='10' />
        <members>
          <member value='5' />
          <member value='10' />
          <member value='20' />
          <member value='50' />
        </members>
      </column>
    </datasource>
