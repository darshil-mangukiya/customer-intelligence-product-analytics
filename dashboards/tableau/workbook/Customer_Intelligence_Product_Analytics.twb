      <column datatype='real' name='[Cohort Retention %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers]) / MIN([cohort_size])' />
      </column>
      <column datatype='integer' name='[Cohort Size (LOD)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [cohort_month] : MAX([cohort_size]) }' />
      </column>
      <column datatype='real' name='[Retention Period Change]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cohort Retention %] - LOOKUP([Cohort Retention %], -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Three-period Moving Retention]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Cohort Retention %], -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
